# Neuron Platform Environment Example (no real secrets)
# Copy to .env and fill values securely (never commit .env)

# Admin & Auth
ADMIN_API_KEY=
ADMIN_HMAC_REQUIRED=false

# Persistence (future Postgres / Redis / Qdrant)
NEON_DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QDRANT_ENDPOINT=
QDRANT_API_KEY=

# Supabase (optional if using Supabase services)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Vector / Embedding Feature Flags
NEURON_VECTOR_ENABLED=0
EMBEDDING_PROVIDER=sentence_transformers  # sentence_transformers | openai | local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2     # alt: mxbai-embed-large (ensure dims match)
OPENAI_API_KEY=

# Embeddings
# (legacy placement retained above; do not duplicate)

# Feature Flags
NEURON_RETRIEVAL_DOCS_ENABLED=0
NEURON_RETRIEVAL_EXPLANATIONS_ENABLED=0
NEURON_RETRIEVAL_HASH_PROVENANCE_ENABLED=0
NEURON_FEEDBACK_INGEST_ENABLED=0
NEURON_INSIGHT_CONTEXT_ENRICH_ENABLED=0
NEURON_PG_ENABLED=0
NEURON_REDIS_ENABLED=0

# Logging
LOG_LEVEL=INFO
