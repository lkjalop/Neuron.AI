{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.x"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "2.x"}
  ],
  "title": "Vulnerability Scanner Overview",
  "editable": true,
  "graphTooltip": 0,
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "panels": [
    {
      "type": "row",
      "title": "Scan Pipeline",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Last Scan Cycle Latency p95 (s)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(scan_cycle_latency_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": ""}},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1}
    },
    {
      "type": "timeseries",
      "title": "Scan Cycle Latency Distribution",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(scan_cycle_latency_seconds_bucket[5m])) by (le)", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 1}
    },
    {
      "type": "stat",
      "title": "SBOM Diff New Vulns (5m)",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "increase(sbom_diff_new_vulns_total[5m])", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1}
    },
    {
      "type": "timeseries",
      "title": "SBOM Diff Churn",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "increase(sbom_diff_component_churn_total[1h])", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}
    },
    {
      "type": "timeseries",
      "title": "Risk Factor Shares (Stacked %)",
      "datasource": "Prometheus",
      "fieldConfig": {"defaults": {"unit": "percent", "custom": {"stacking": {"mode": "normal"}}}},
      "targets": [
        {"expr": "risk_factor_share_percent", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}
    },
    {
      "type": "row",
      "title": "Retrieval Quality",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13}
    },
    {
      "type": "timeseries",
      "title": "Retrieval Overlap Precision",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "retrieval_overlap_precision", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 14}
    },
    {
      "type": "timeseries",
      "title": "Retrieval TopK Drift",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "retrieval_topk_drift", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 14}
    },
    {
      "type": "row",
      "title": "Daily Assessment",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 20}
    },
    {
      "type": "timeseries",
      "title": "Daily Assessment Slope",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "daily_assessment_slope", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 21}
    },
    {
      "type": "stat",
      "title": "Assessment ETA Days",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "daily_assessment_eta_days", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 21}
    },
    {
      "type": "stat",
      "title": "Assessments Generated (24h)",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "increase(daily_assessment_generated_total[24h])", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 21}
    },
    {
      "type": "row",
      "title": "Automation & SLA",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25}
    },
    {
      "type": "stat",
      "title": "Active SLA Breaches Critical",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "vuln_sla_breach_active{severity=\"CRITICAL\"}", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 26}
    },
    {
      "type": "stat",
      "title": "Active SLA Breaches High",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "vuln_sla_breach_active{severity=\"HIGH\"}", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 26}
    },
    {
      "type": "stat",
      "title": "SLA Breaches 24h",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "increase(vuln_sla_breach_total[24h])", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 26}
    },
    {
      "type": "timeseries",
      "title": "Factor Volatility",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "vuln_factor_volatility", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 26}
    },
    {
      "type": "row",
      "title": "Predictive Signals",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}
    },
    {
      "type": "stat",
      "title": "TTR Estimate (Days)",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "vuln_ttr_estimate_days", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 33}
    },
    {
      "type": "stat",
      "title": "TTR Confidence",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "vuln_ttr_confidence", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 33}
    },
    {
      "type": "gauge",
      "title": "TTR Confidence Gauge",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 0.3},
              {"color": "green", "value": 0.7}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {"expr": "vuln_ttr_confidence", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 37}
    },
    {
      "type": "timeseries",
      "title": "Exploit Likelihood (Top CVEs)",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "topk(10, vuln_exploit_likelihood)", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 33}
    },
    {
      "type": "timeseries",
      "title": "Exploit Trend Slope",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "vuln_exploit_trend_slope", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 4, "x": 16, "y": 33}
    },
    {
      "type": "stat",
      "title": "Exposure Clusters",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "vuln_exposure_cluster_count", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 33}
    },
    {
      "type": "timeseries",
      "title": "Cluster Risk Scores",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "vuln_exposure_cluster_risk", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 39}
    },
    {
      "type": "timeseries",
      "title": "Automation Events Rate",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "increase(vuln_automation_events_total[1h])", "refId": "A"}
      ],
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 39}
    }
  ],
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s"
}