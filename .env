# Neuron-AI Development Environment Configuration
# Copy this file and set your actual values - DO NOT commit real credentials

# Database Configuration (use your own database URL)
DATABASE_URL="postgresql://user:password@localhost:5432/neuronai"
NEON_DATABASE_URL="postgresql://user:password@your-neon-db.com:5432/db"

# Redis Configuration (use your own Redis instance)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token-here"

# Qdrant Vector Database (use your own instance)
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_URL="https://your-qdrant-instance.cloud.qdrant.io:6333"

# API Configuration (generate your own secure keys)
PREDICT_API_KEY="your-prediction-api-key"
ADMIN_API_KEY="your-admin-api-key"
ALLOW_PARTIAL_READINESS=1

# Prometheus & Grafana
PROMETHEUS_URL="http://localhost:9090"
GRAFANA_BASE_URL="http://localhost:3000"

# Embedding Model (using local for performance)
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Redis Memory Limit
UPSTASH_MEMORY_LIMIT_MB=50